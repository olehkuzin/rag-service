# ---- corpus / storage ----
RAG_CORPUS_DIR=data/corpus
RAG_INDEX_DIR=data/index
RAG_VECTOR_STORE=local            # local | qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=dbt_docs

# ---- Mistral ----
MISTRAL_API_KEY=

# ---- embeddings ----
RAG_EMBEDDING_PROVIDER=mistral    # hash | mistral
RAG_EMBEDDING_MODEL=mistral-embed
RAG_EMBEDDING_DIM=1024            # mistral-embed is 1024-dim; must match or ingestion fails

# ---- llm ----
RAG_LLM_PROVIDER=mistral          # fake | mistral
RAG_LLM_MODEL=mistral-large-latest
RAG_LLM_MAX_TOKENS=1024

# ---- retrieval ----
RAG_CHUNK_MAX_CHARS=1800
RAG_CHUNK_MIN_CHARS=120
RAG_CHUNK_OVERLAP_CHARS=200
RAG_CHUNK_STRATEGY=structure      # structure | fixed
RAG_DEFAULT_TOP_K=5
RAG_VECTOR_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_RERANK_CANDIDATES=20

# ---- features ----
RAG_ENABLE_HYBRID=true
RAG_ENABLE_RERANK=true
RAG_PROMPT_VARIANT=strict         # basic | strict

# ---- api ----
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
